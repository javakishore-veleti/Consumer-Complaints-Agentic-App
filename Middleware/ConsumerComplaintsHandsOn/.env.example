# Copy to .env (git-ignored) and fill in the values. Never commit a real value (D42).
# run_app.sh exports every name set here to the API.

# Notes: keep the secret plain ASCII. run_app.sh sources this file with the shell, so quote a value that contains
# spaces or $ (CCA_CALLBACK_SECRET='a b$c'). A value set here overrides the same variable exported in the shell.

# Shared secret Airflow sends in the X-Callback-Secret header of every callback (D59).
# Without it every callback endpoint answers 401. Generate one with: openssl rand -hex 32
CCA_CALLBACK_SECRET=

# Base URL the Airflow workers use to reach this API for status callbacks (D67).
# From Airflow containers on Docker Desktop: http://host.docker.internal:8000
CCA_API_URL=

# Operational DB URL (also upserted into Airflow Variables for DAGs, D51 / D42).
CCA_DB_URL=

# Directory where the CFPB zip lands inside the Airflow worker (D57 / D63). Name only in catalog; value per env.
LOCAL_DATA_PATH_CFPB=

# Airflow public API (local compose defaults). Used by upsert-secrets only — not upserted into Variables.
CCA_AIRFLOW_API_BASE_URL=http://127.0.0.1:8080
CCA_AIRFLOW_API_USERNAME=airflow
CCA_AIRFLOW_API_PASSWORD=
