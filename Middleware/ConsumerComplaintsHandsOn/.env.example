# Copy to .env (git-ignored) and fill in the values. Never commit a real value (D42).
# run_app.sh exports every name set here to the API.

# Notes: keep the secret plain ASCII. run_app.sh sources this file with the shell, so quote a value that contains
# spaces or $ (CCA_CALLBACK_SECRET='a b$c'). A value set here overrides the same variable exported in the shell.

# Shared secret Airflow sends in the X-Callback-Secret header of every callback (D59).
# Without it every callback endpoint answers 401. Generate one with: openssl rand -hex 32
CCA_CALLBACK_SECRET=

# Base URL the Airflow workers use to reach this API for status callbacks (D67).
# From Airflow containers on Docker Desktop: http://host.docker.internal:8000
CCA_API_URL=

# --- Operational / admin store profiles (D75) ---
# Same DAO interfaces for workflows, MIOs, catalog, ingest/exec logs. Facades/API do not branch on backend.
#
# Profile 1 — SQLite (default, fewest containers): leave CCA_OPERATIONAL_STORE and CCA_DB_URL unset.
#   Optional: CCA_OPERATIONAL_STORE=sqlite
#   Optional: CCA_DATA_DIR=/path/to/.data  (default: Middleware/ConsumerComplaintsHandsOn/.data)
#   Containers: npm run local:containers:sqlite:start  (Airflow only; D78 — no operational Postgres)
#
# Profile 2 — Postgres: set a SQLAlchemy URL + opt-in container (D77/D78).
#   npm run local:containers:postgres:start
#   # alternate: docker run -d --name cca-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=cca -p 5432:5432 postgres:16
#   CCA_OPERATIONAL_STORE=postgres
#   CCA_DB_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/cca
#   Then: alembic upgrade head (or run_app.sh start). Same APIs as SQLite (D77).
#   (If CCA_OPERATIONAL_STORE is unset, a postgresql… CCA_DB_URL alone selects postgres.)
#   Verify: CCA_TEST_POSTGRES_URL=$CCA_DB_URL uv run pytest tests/test_postgres.py
#
# Profile 3 — MongoDB as the operational store (not the complaint-document DB of D10).
#   npm run local:containers:mongodb:start
#   CCA_OPERATIONAL_STORE=mongodb
#   CCA_MONGO_OPERATIONAL_URL=mongodb://USER:PASSWORD@127.0.0.1:27017/cca_operational
#   (Mongo DAO impls: story #119. Until then the API refuses to start on this profile.)

# Optional explicit profile: sqlite | postgres | mongodb (trimmed, case-insensitive).
CCA_OPERATIONAL_STORE=

# Operational DB URL for SQLAlchemy backends (also upserted into Airflow Variables for DAGs, D51 / D42).
# Unset → SQLite file under CCA_DATA_DIR/operational.sqlite.
CCA_DB_URL=

# SQLite file directory (default: .data under the app root). Ignored for Postgres/Mongo operational profiles.
# CCA_DATA_DIR=

# MongoDB URI when CCA_OPERATIONAL_STORE=mongodb (operational/admin collections, D75).
CCA_MONGO_OPERATIONAL_URL=

# Directory where the CFPB zip lands inside the Airflow worker (D57 / D63). Name only in catalog; value per env.
LOCAL_DATA_PATH_CFPB=

# Airflow public API (local compose defaults). Used by upsert-secrets only — not upserted into Variables.
CCA_AIRFLOW_API_BASE_URL=http://127.0.0.1:8080
CCA_AIRFLOW_API_USERNAME=airflow
CCA_AIRFLOW_API_PASSWORD=
