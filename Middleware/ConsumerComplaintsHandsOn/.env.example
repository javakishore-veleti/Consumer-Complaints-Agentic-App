# Copy to .env (git-ignored) and fill in the values. Never commit a real value (D42).
# run_app.sh exports every name set here to the API.
#
# Inventory (M04 #154): names listed in CICD/Local/airflow/Airflow_Variables_Upsert.txt are copied into
# Airflow Variables by POST /management/airflow/upsert-secrets (Admin Operations → Sync secrets).
# Names marked API-only below stay in the Middleware process only — they are not upserted.
#
# Notes: keep the secret plain ASCII. run_app.sh sources this file with the shell, so quote a value that contains
# spaces or $ (CCA_CALLBACK_SECRET='a b$c'). A value set here overrides the same variable exported in the shell.

# [upsert] Shared secret Airflow sends in the X-Callback-Secret header of every callback (D59).
# Without it every callback endpoint answers 401. Generate one with: openssl rand -hex 32
CCA_CALLBACK_SECRET=

# [upsert] Base URL the Airflow workers use to reach this API for status callbacks (D67).
# From Airflow containers on Docker Desktop: http://host.docker.internal:8000
CCA_API_URL=

# --- Operational / admin store profiles (D75) ---
# Same DAO interfaces for workflows, MIOs, catalog, ingest/exec logs. Facades/API do not branch on backend.
#
# Profile 1 — SQLite (default, fewest containers): leave CCA_OPERATIONAL_STORE and CCA_DB_URL unset.
#   Optional: CCA_OPERATIONAL_STORE=sqlite
#   Optional: CCA_DATA_DIR=/path/to/.data  (default: Middleware/ConsumerComplaintsHandsOn/.data)
#   Containers: npm run local:containers:sqlite:start  (Airflow only; D78 — no operational Postgres)
#
# Profile 2 — Postgres: set a SQLAlchemy URL + opt-in container (D77/D78).
#   npm run local:containers:postgres:start
#   # alternate: docker run -d --name cca-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=cca -p 5432:5432 postgres:16
#   CCA_OPERATIONAL_STORE=postgres
#   CCA_DB_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/cca
#   Then: alembic upgrade head (or run_app.sh start). Same APIs as SQLite (D77).
#   (If CCA_OPERATIONAL_STORE is unset, a postgresql… CCA_DB_URL alone selects postgres.)
#   Verify: CCA_TEST_POSTGRES_URL=$CCA_DB_URL uv run pytest tests/test_postgres.py
#
# Profile 3 — MongoDB as the operational store (not the complaint-document DB of D10).
#   npm run local:containers:mongodb:start
#   CCA_OPERATIONAL_STORE=mongodb
#   CCA_MONGO_OPERATIONAL_URL=mongodb://root:changeme-local@127.0.0.1:27017/cca_operational?authSource=admin
#   Then: run_app.sh start (bootstraps indexes + seed; skips Alembic). Same APIs as SQLite (D79).
#   Verify: uv run pytest tests/test_mongodb_operational_store.py
#   Optional real Mongo: CCA_TEST_MONGO_OPERATIONAL_URL=$CCA_MONGO_OPERATIONAL_URL …

# [API-only] Optional explicit profile: sqlite | postgres | mongodb (trimmed, case-insensitive).
CCA_OPERATIONAL_STORE=

# [upsert] Operational DB URL for SQLAlchemy backends (also upserted into Airflow Variables for DAGs, D51 / D42).
# Unset → SQLite file under CCA_DATA_DIR/operational.sqlite.
CCA_DB_URL=

# [API-only] SQLite file directory (default: .data under the app root). Ignored for Postgres/Mongo operational profiles.
# CCA_DATA_DIR=

# [API-only] MongoDB URI when CCA_OPERATIONAL_STORE=mongodb (operational/admin collections, D75).
CCA_MONGO_OPERATIONAL_URL=

# [upsert] Complaint-document Mongo URI for Airflow ingest DAG (D86). Not the operational store.
# Example: mongodb://root:changeme-local@host.docker.internal:27017/consumer_comp_db?authSource=admin
CCA_MONGO_COMPLAINTS_URL=

# [upsert] Local vector store directory for index_cfpb_all (D88). JSONL files under this path.
# Example: /opt/airflow/data/vectors
CCA_VECTOR_STORE_PATH=

# [upsert] Directory where the CFPB zip lands inside the Airflow worker (D57 / D63). Name only in catalog; value per env.
LOCAL_DATA_PATH_CFPB=

# [upsert] Local directory of pre-split CFPB parts (complaints_part_*.csv.zip) to stage into LOCAL_DATA_PATH_CFPB (D91).
# Never hardcode a developer Downloads path in code — set this per machine.
CCA_CFPB_SPLIT_SOURCE_PATH=

# [upsert] Postgres+pgvector DSN on ops Postgres (D94). After npm run local:containers:postgres:start:
# postgresql://postgres:postgres@127.0.0.1:5432/cca
CCA_PGVECTOR_URL=

# [upsert] Chroma HTTP base URL (D94 / M10-0001). After npm run local:containers:chroma:start:
# http://127.0.0.1:8100  (host 8100 → container 8000; avoids Middleware API :8000)
CCA_CHROMA_URL=

# [upsert] Redis Stack URL for vector + cache (D94). After npm run local:containers:redis:start:
# redis://127.0.0.1:6379/0
CCA_REDIS_URL=

# [API-only] Airflow public API (local compose defaults). Used by upsert-secrets client — not upserted into Variables.
CCA_AIRFLOW_API_BASE_URL=http://127.0.0.1:8080
CCA_AIRFLOW_API_USERNAME=airflow
CCA_AIRFLOW_API_PASSWORD=
