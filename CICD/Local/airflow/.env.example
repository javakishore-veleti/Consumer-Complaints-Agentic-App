# Copy to airflow/.env. Generate secrets with:
#   FERNET_KEY:  openssl rand -base64 32 | tr '+/' '-_'
#   JWT secret:  openssl rand -hex 32
AIRFLOW_UID=50000
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
# Optional: AIRFLOW_PORT=8080  _AIRFLOW_WWW_USER_USERNAME=airflow  _AIRFLOW_WWW_USER_PASSWORD=airflow
