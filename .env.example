# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=

# Local pgvector from docker-compose.yml (default). To use Supabase instead, paste its
# connection string here (the notebook in the video used SUPABASE_DB_URL; both names work).
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/cfpb

# Models (any OpenAI chat model that supports structured outputs).
CHAT_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small
