{
  "name": "consumer-complaints-agentic-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "local:containers:all:start": "bash CICD/Local/docker-all-up.sh",
    "local:containers:all:stop": "bash CICD/Local/docker-all-down.sh",
    "local:containers:all:status": "bash CICD/Local/docker-all-status.sh",
    "local:containers:sqlite:start": "bash CICD/Local/docker-all-up.sh --profile sqlite",
    "local:containers:sqlite:stop": "bash CICD/Local/docker-all-down.sh --profile sqlite",
    "local:containers:sqlite:status": "bash CICD/Local/docker-all-status.sh --profile sqlite",
    "local:containers:postgres:start": "bash CICD/Local/docker-all-up.sh --profile postgres",
    "local:containers:postgres:stop": "bash CICD/Local/docker-all-down.sh --profile postgres",
    "local:containers:postgres:status": "bash CICD/Local/docker-all-status.sh --profile postgres",
    "local:containers:mongodb:start": "bash CICD/Local/docker-all-up.sh --profile mongodb",
    "local:containers:mongodb:stop": "bash CICD/Local/docker-all-down.sh --profile mongodb",
    "local:containers:mongodb:status": "bash CICD/Local/docker-all-status.sh --profile mongodb",
    "local:api:migrate": "cd Middleware/ConsumerComplaintsHandsOn && uv run alembic upgrade head",
    "local:handson:middlware:all:start": "bash Middleware/ConsumerComplaintsHandsOn/run_app.sh start",
    "local:handson:middlware:all:stop": "bash Middleware/ConsumerComplaintsHandsOn/run_app.sh stop",
    "local:handson:middlware:all:status": "bash Middleware/ConsumerComplaintsHandsOn/run_app.sh status",
    "local:api:openapi": "cd Middleware/ConsumerComplaintsHandsOn && uv run python scripts/export_openapi.py",
    "local:api:lint": "cd Middleware/ConsumerComplaintsHandsOn && uv run lint-imports",
    "local:api:test": "cd Middleware/ConsumerComplaintsHandsOn && uv run pytest",
    "local:portals:all:start": "bash CICD/Local/portals-all.sh start",
    "local:portals:all:stop": "bash CICD/Local/portals-all.sh stop",
    "local:portals:all:status": "bash CICD/Local/portals-all.sh status",
    "local:portal:admin:start": "npm --prefix Portals/consumer-complaints-admin start",
    "local:portal:admin:build": "npm --prefix Portals/consumer-complaints-admin run build",
    "local:portal:admin:test": "npm --prefix Portals/consumer-complaints-admin test -- --watch=false",
    "local:portal:intellect:start": "npm --prefix Portals/consumer-complaints-intellect start",
    "local:portal:intellect:build": "npm --prefix Portals/consumer-complaints-intellect run build",
    "local:portal:intellect:test": "npm --prefix Portals/consumer-complaints-intellect test",
    "local:portal:admin:with-api": "npm run local:handson:middlware:all:start && npm run local:portals:all:start",
    "local:e2e:happy-path:smoke": "cd Middleware/ConsumerComplaintsHandsOn && uv run pytest tests/test_e2e_happy_path_smoke.py -q",
    "local:e2e:happy-path:probe": "python3 CICD/Local/e2e_happy_path_smoke.py",
    "local:e2e:dod-matrix:sqlite": "cd Middleware/ConsumerComplaintsHandsOn && uv run pytest tests/test_e2e_happy_path_smoke.py::test_happy_path_start_callback_mios_status -q",
    "local:e2e:dod-matrix:postgres": "cd Middleware/ConsumerComplaintsHandsOn && uv run pytest tests/test_postgres.py::test_start_workflow_and_callback_persist_on_postgres -q",
    "local:e2e:dod-matrix:mongodb": "cd Middleware/ConsumerComplaintsHandsOn && uv run pytest tests/test_mongodb_operational_store.py::test_start_workflow_and_callback_persist_on_mongo -q",
    "local:e2e:dod-matrix:smoke": "bash CICD/Local/dod_matrix_smoke.sh"
  },
  "author": "",
  "license": "ISC"
}
